{
  "name": "spicy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "spicy-db", "database_id": "PASTE_YOUR_D1_DATABASE_ID" }
  ]
}
